# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key powering the agent features (briefing/anomaly/chat).
# This is YOUR key, not the end user's — usage is capped/rate-limited server-side.
ANTHROPIC_API_KEY=

# Base URL of the deployed app, used for server-side fetches to the
# Python forecasting function during local dev (e.g. http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authenticates Vercel Cron's calls to /api/cron/sync (the background job
# that syncs every connection's usage data + key metadata on a schedule --
# see vercel.json). Vercel sends this automatically as a Bearer token when
# the env var of the same name is set in the project's settings; generate
# any long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=
