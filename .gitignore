# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which README's setup steps tell you to copy.
!.env.local.example

# vercel
.vercel

# python (api/forecast.py local testing)
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent/authoring notes -- not part of the project itself.
# AGENTS.md is regenerated by `next dev` on every run, so it stays ignored
# rather than reappearing as an uncommitted change after each start.
AGENTS.md
CLAUDE.md
.claude/
docs/ramp-project-implementation-phases.md
